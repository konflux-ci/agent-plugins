{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Marketplace Manifest",
  "description": "Schema for validating .claude-plugin/marketplace.json",
  "type": "object",
  "required": ["name", "owner", "plugins"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1}
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source", "description", "version", "author"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Skill name using only lowercase letters, numbers, and hyphens"
          },
          "source": {
            "type": "string",
            "pattern": "^\\./skills/[a-z0-9-]+$",
            "description": "Relative path to the skill directory"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
            "description": "Semver version (MAJOR.MINOR.PATCH)"
          },
          "author": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
